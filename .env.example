# No environment variables are needed for local single-device mode.
# Supabase Auth/cloud storage and provider adapters are not connected yet.
# Future public publishable configuration must be distinct from server secrets.

# Optional Supabase Auth. Leave blank for the explicit local browser profile.
# Configure an isolated development project and callback allowlist first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: required for authenticated atomic cloud commands, never NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
# Set to the actual canonical HTTPS origin when deploying behind a proxy.
LEXIS_APP_ORIGIN=

# Optional paid AI: disabled until an operator verifies API/model availability,
# current pricing, data-processing terms and authorization for a test budget.
# No default model or prices. A ChatGPT subscription is not an API budget.
LEXIS_AI_ENABLED=false
LEXIS_AI_PROVIDER=
LEXIS_AI_MODEL=
OPENAI_API_KEY=
LEXIS_AI_MAX_OUTPUT_TOKENS=
LEXIS_AI_DAILY_REQUEST_LIMIT=
LEXIS_AI_DAILY_BUDGET_USD=
LEXIS_AI_SERVER_DAILY_BUDGET_USD=
LEXIS_AI_INPUT_USD_PER_MILLION=
LEXIS_AI_OUTPUT_USD_PER_MILLION=
